# Copy to .env at the repo root, and to apps/api/.env and packages/db/.env as needed.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://engage:engage@localhost:5432/engage?schema=public

# Redis: presence, socket.io adapter, caching
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# News provider (pending client decision: NewsAPI / GNews / curated)
NEWS_API_KEY=

# Supabase (Project Settings → API). The publishable key is safe in the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# For Prisma, use the Supabase connection string (Project Settings → Database):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
